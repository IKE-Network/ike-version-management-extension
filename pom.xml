<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Network — Version Management Maven Extension
  ════════════════════════════════════════════════

  A Maven 4 build extension that implements the IKE GA·convention
  for version-property naming (IKE-Network/ike-issues#470, #471,
  #472). Hooks ModelTransformer to:

    1. Inject ${G·A} ↔ legacy-short-name property indirections
       at file-model stage, sourced from a bundled alias manifest
       (META-INF/ike/version-aliases.yaml) and an optional
       per-project override (.mvn/version-aliases.yaml).
    2. Fail the build at effective-model stage with an actionable
       message when a <dependency>/<plugin> <version> reference
       points at an undeclared ${G·A} property.
    3. Detect ${G.A} typos (regular dots where the middle dot
       was meant) by checking whether the dot-to-middle-dot
       substitution resolves; emit a "did you mean ${G·A}?" hint.
    4. Validate ${G·A·policy} release-policy property values
       against the ReleasePolicy ladder, with a closest-match
       "did you mean" hint (IKE-Network/ike-issues#498).

  See IKE-VERSIONS.md (in ike-build-standards) for the convention.

  Standalone Tier 0 artifact, parent ike-base-parent. Versioned
  independently. It enforces the IKE version and release-policy
  conventions, and depends only on ike-java-support.

  Build:    mvn install
  Artifact: network.ike.tooling:ike-version-management-extension:<version>
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
                             http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike</groupId>
        <artifactId>ike-base-parent</artifactId>
        <version>6</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.tooling</groupId>
    <artifactId>ike-version-management-extension</artifactId>
    <version>2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>IKE Version Management Extension</name>
    <description>
        Maven 4 build extension that implements the IKE GA·convention
        for version-property naming: ${groupId·artifactId} (U+00B7
        MIDDLE DOT). Injects alias indirections from a bundled
        manifest, fails fast on undeclared ${G·A} references, and
        detects ${G.A} typos with a corrective hint. See
        IKE-Network/ike-issues#470, #472.
    </description>
    <url>https://github.com/IKE-Network/ike-version-management-extension</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <!-- Locally declared so the cascade's coordinate-to-repository
         lookup resolves a real repo URL, not the artifactId-appended
         path Maven would otherwise inherit from ike-base-parent.
         This artifact is also the host of the MISSING_SCM lint that
         enforces the rule; it must pass its own check. See
         IKE-Network/ike-issues#496. -->
    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-version-management-extension.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-version-management-extension.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-version-management-extension</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.deploy.skip>false</maven.deploy.skip>
        <maven.install.skip>false</maven.install.skip>
        <!-- Pin to the Maven 4 line the IKE workspaces ship. -->
        <maven.version>4.0.0-rc-5</maven.version>
    </properties>

    <!-- Maven 4 API dependencies are compile-scope (not provided), per
         the maveniverse/mason canonical wiring. The annotation
         processor in maven-api-di emits META-INF/maven/o.a.m.a.di.Inject
         when <proc>full</proc> is set on the compiler. -->
    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-spi</artifactId>
            <version>${maven.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-core</artifactId>
            <version>${maven.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-model</artifactId>
            <version>${maven.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-di</artifactId>
            <version>${maven.version}</version>
        </dependency>

        <!-- IKE shared value types: ReleasePolicy and the
             ConstantBackedEnum contract, used by the release-policy
             validation rule. Compile scope — it loads into the
             extension's classloader. Literal version until
             ike-java-support is released and ike-base-parent carries
             a canonical pin. See IKE-Network/ike-issues#498. -->
        <dependency>
            <groupId>network.ike</groupId>
            <artifactId>ike-java-support</artifactId>
            <version>1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <!--
        No in-repo tests. The transformer's behavior is exercised by
        integration tests in a consuming reactor (workspace-reactor-example
        is the obvious primary target). Keeping this artifact pure-
        library lets ike-base-parent be a clean Tier 0 inheritance
        with no test-stack baggage.
    -->

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                    <!-- maven-api-di's DiIndexProcessor emits
                         META-INF/maven/org.apache.maven.api.di.Inject,
                         which is how Maven 4 discovers our @Named bean.
                         <proc>full</proc> lets Maven scan the classpath
                         for processors (maven-api-di brings the
                         processor itself in via its jar). -->
                    <proc>full</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
